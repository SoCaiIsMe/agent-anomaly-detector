# 异常检测模型配置
# 请复制为 .env 文件并填写实际值

# API 提供商 (ollama 或 vllm)
ANOMALY_API_PROVIDER=ollama

# 远程 Ollama 服务器地址
ANOMALY_OLLAMA_URL=http://192.168.1.100:11434/api/generate

# 模型名称
ANOMALY_MODEL=qwen2.5:7b

# 检测阈值 (0.0-1.0)
ANOMALY_THRESHOLD=0.7

# 可选：API 密钥（如果需要认证）
# ANOMALY_API_KEY=your_api_key_here

# 可选：超时设置（秒）
# ANOMALY_TIMEOUT=60

# 可选：代理设置
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
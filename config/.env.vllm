# vLLM 异常检测模型配置
# 请复制为 .env 文件并填写实际值

# API 提供商 (vllm 或 ollama)
ANOMALY_API_PROVIDER=vllm

# 远程 vLLM 服务器地址
ANOMALY_VLLM_URL=http://211.87.232.207:8001/v1/completions

# 模型名称（需要与 vLLM 服务器上的模型名称一致）
ANOMALY_MODEL=qwen2.5:7b

# 检测阈值 (0.0-1.0)
ANOMALY_THRESHOLD=0.7

# 可选：API 密钥（如果需要认证）
# ANOMALY_API_KEY=your_api_key_here

# 可选：超时设置（秒）
ANOMALY_TIMEOUT=60

# 可选：代理设置
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# vLLM 特定配置
# 温度参数（控制随机性）
ANOMALY_TEMPERATURE=0.1
# 最大生成长度
ANOMALY_MAX_TOKENS=1024